{
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "autoDocstringPy": {
    "docstringFormat": "google-notypes",
    "startOnNewLine": true
  },
  "basedpyright": {
    "analysis": {
      "baselineMode": "discard"
    }
  },
  "python": {
    "analysis": {
      "diagnosticMode": "workspace",
      "enablePytestSupport": true
    },
    "testing": {
      "pytestArgs": [
        "."
      ],
      "pytestEnabled": true,
      "unittestEnabled": false
    }
  },
  "python-envs": {
    "defaultEnvManager": "pypa.hatch:hatch",
    "defaultPackageManager": "pypa.hatch:hatch"
  }
}
